/dts-v1/;
#include "zynq-coraz7s.dtsi"

&spi0 {
    status = "okay";
    ad5592r_s: spi_adc@0 {
        reg = <0>;
        spi-max-frequency = <10000000>;
        compatible = "ad5592r_s";
    };
};